# Dependencies & build output (do NOT ignore apps/web/.next/standalone/**/node_modules —
# Next standalone needs those packages inside the web image).
/node_modules
apps/web/node_modules
apps/api/node_modules
packages/*/node_modules
**/.turbo
.pnpm-store

# Keep apps/web/.next for prebuilt web image (host builds Next; Docker packages it).
# Other packages' dist still excluded:
packages/**/dist
apps/api/bin

# Git / IDE
.git
.cursor
**/.DS_Store

# Docs & plans (not needed in images)
docs
plans

# Local env
.env
.env.*
!.env.example

# Go binaries
**/*.exe
**/*.test

# Large / irrelevant
**/*.md
!README.md

# Playwright E2E (not needed in production web image)
apps/web/e2e
apps/web/playwright.config.ts
apps/web/test-results
apps/web/e2e-run*.log

# Prebuilt Go binaries (host-built; Docker only packages them)
# do not ignore apps/api/prebuilt/
