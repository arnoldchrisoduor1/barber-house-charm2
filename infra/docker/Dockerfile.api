# Prebuilt API image — requires apps/api/prebuilt-api.tar.gz in repo.
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY apps/api/prebuilt-api.tar.gz /tmp/prebuilt-api.tar.gz

RUN tar -xzf /tmp/prebuilt-api.tar.gz -C /tmp && \
    mv /tmp/linux-amd64/* /app/ && \
    rm -rf /tmp/prebuilt-api.tar.gz /tmp/linux-amd64

COPY infra/migrations /app/migrations

RUN chmod +x /app/api /app/worker /app/migrate /app/seed

EXPOSE 8080
CMD ["/app/api"]
