# Prebuilt API image — run scripts/build-api-linux.sh on the host first.
# Packages api, worker, migrate, seed (linux/amd64 static binaries).
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY apps/api/prebuilt/linux-amd64/api \
     apps/api/prebuilt/linux-amd64/worker \
     apps/api/prebuilt/linux-amd64/migrate \
     apps/api/prebuilt/linux-amd64/seed \
     ./

COPY infra/migrations /app/migrations

RUN chmod +x /app/api /app/worker /app/migrate /app/seed

EXPOSE 8080
CMD ["/app/api"]
