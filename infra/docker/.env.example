# Copy to infra/docker/.env on the server and fill in real values.
# Used by: docker compose -f compose.yml -f compose.prod.yml up -d --build

# --- Postgres ---
POSTGRES_USER=haus
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=haus

# --- API (production) ---
APP_ENV=production
JWT_ACCESS_SECRET=change-me-long-random-access
JWT_REFRESH_SECRET=change-me-long-random-refresh
JWT_ACCESS_TTL=24h
CORS_ORIGINS=https://hauseoftech.com,https://www.hauseoftech.com
PUBLIC_WEB_URL=https://hauseoftech.com

# --- SMTP (required for invites / 2FA / verify-email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_FROM=noreply@hauseoftech.com
EMAIL_FROM_NAME=Haus of Wellness
EMAIL_DRY_RUN=false

# --- Object storage (MinIO in compose, or R2/S3 in prod) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-minio
S3_BUCKET=haus-media
S3_USE_SSL=false
# S3_PUBLIC_URL=https://cdn.hauseoftech.com

# --- Payments (optional until go-live) ---
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_ENV=sandbox

# --- Integrations (optional) ---
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
