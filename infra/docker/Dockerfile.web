# Prebuilt web image — requires apps/web/prebuilt-next.tar.gz in repo.
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY apps/web/prebuilt-next.tar.gz /tmp/prebuilt-next.tar.gz
COPY apps/web/public ./apps/web/public

RUN mkdir -p apps/web/.next && \
    tar -xzf /tmp/prebuilt-next.tar.gz -C apps/web/.next && \
    cp -aL apps/web/.next/standalone/. . && \
    rm -rf apps/web/.next /tmp/prebuilt-next.tar.gz

COPY infra/docker/docker-entrypoint-web.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["sh", "/docker-entrypoint.sh"]
