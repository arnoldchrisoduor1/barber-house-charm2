# Prebuilt web image: run `pnpm --filter @haus/web build` on the host first.
# Docker Desktop containers cannot reach npm/Alpine CDN (TLS leaf verify fails).
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Standalone output places server.js at the tracing root (/app), not apps/web/
COPY apps/web/.next/standalone ./
COPY apps/web/.next/static ./apps/web/.next/static
COPY apps/web/public ./apps/web/public
COPY infra/docker/docker-entrypoint-web.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["sh", "/docker-entrypoint.sh"]
